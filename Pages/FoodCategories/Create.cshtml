@page
@model FoodStore.Pages.FoodCategories.CreateModel

@{
    ViewData["Title"] = "Create";
}

<div class="container mt-5">
    <h4>New FoodCategory</h4>
<hr />
 <div class="row d-flex flex-column justify-content-center align-items-center">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="FoodCategory.CategoryName" class="control-label"></label>
                <input asp-for="FoodCategory.CategoryName" class="form-control" />
                <span asp-validation-for="FoodCategory.CategoryName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="FoodCategory.Description" class="control-label"></label>
                <textarea asp-for="FoodCategory.Description" class="form-control"></textarea>
                <span asp-validation-for="FoodCategory.Description" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary col-12 mt-5" />
            </div>
            <div>
                <a class="btn btn-outline-secondary col-12 mt-2" asp-page="Index">Back to List</a>
            </div>
        </form>
    </div>
</div>


</div>



@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
