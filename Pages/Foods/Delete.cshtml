@page
@model FoodStore.Pages.Foods.DeleteModel

@{
    ViewData["Title"] = "Delete";
}

<div class="container-fluid card mt-3">
    <h1>Delete Food</h1>

    <h3>Are you sure you want to delete this?</h3>
    <div>
        <hr />
        <dl class="row">
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.Food.FoodName)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Food.FoodName)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.Food.FoodDescription)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Food.FoodDescription)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.Food.Image)
            </dt>
            <dd class="col-sm-10">
                <img src="data:image/jpeg;base64,@Convert.ToBase64String(Model.Food.Image)" style="width: 100%; height: auto;max-width:500px;" />
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.Food.Category)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Food.Category!.CategoryName)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.Food.Ingredients)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Food.Ingredients)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.Food.Price)
            </dt>
            <dd class="col-sm-10">
                @(Html.DisplayFor(model => model.Food.Price))
            </dd>
        </dl>

        <form method="post">
            <input type="hidden" asp-for="Food.foodId" />
            <input type="submit" value="Delete" class="btn btn-danger" /> |
            <a asp-page="./Index">Back to List</a>
        </form>
    </div>
</div>

